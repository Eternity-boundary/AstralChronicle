        Boolean AutoScroll{ get; set; };
        Boolean GroupRepeated{ get; set; };
        Boolean ShowCritical{ get; set; };
        Boolean ShowErrors{ get; set; };
        Boolean ShowWarnings{ get; set; };
        Boolean ShowInformation{ get; set; };
        Boolean IsRecording{ get; };
        String EventsPerSecond{ get; };
        UInt64 TotalReceived{ get; };
        UInt32 CriticalCount{ get; };
        UInt32 ErrorCount{ get; };
        UInt32 WarningCount{ get; };
        UInt32 QueueDepth{ get; };
        String Duration{ get; };
        UInt32 BookmarkCount{ get; };
        Boolean IsRunning{ get; };
        Boolean IsPaused{ get; };
        Boolean CanStart{ get; };
        UInt32 DroppedCount{ get; };
        UInt32 EventCount{ get; };
        Windows.Foundation.Collections.IObservableVector<EventLogItemViewModel> Events{ get; };
        EventLogItemViewModel SelectedEvent{ get; set; };
        Boolean HasSelection{ get; };
        String SelectedProvider{ get; };
        String SelectedEventId{ get; };
        String SelectedVersion{ get; };
        String SelectedLevel{ get; };
        String SelectedOpcode{ get; };
        String SelectedKeywords{ get; };
        String SelectedTimeCreated{ get; };
        String SelectedTaskCategory{ get; };
        String SelectedChannel{ get; };
        String SelectedUser{ get; };
        String SelectedComputer{ get; };
        String SelectedRecordId{ get; };
        String SelectedProcessId{ get; };
        String SelectedThreadId{ get; };
        String SelectedActivityId{ get; };
        String SelectedRelatedActivityId{ get; };
        String SelectedDescription{ get; };
        String SelectedMessage{ get; };
        String SelectedXml{ get; };
        String SelectedEventData{ get; };
        String SelectedUserData{ get; };
        String SelectedProviderMetadata{ get; };
        String SelectedBinaryData{ get; };
        String SelectedRelatedEvents{ get; };
        String DetailsStatusText{ get; };
        Boolean IsDetailsLoading{ get; };
        Microsoft.UI.Xaml.Controls.InfoBarSeverity StatusSeverity{ get; };
        Boolean HasStatusMessage{ get; };
        void Start();
        void Pause();
        void Resume();
        void Stop();
        void Clear();
